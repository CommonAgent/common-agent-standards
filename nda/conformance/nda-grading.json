  "absence": {
    "comment": "What a reader may conclude from a member or value that is not there. The weak meaning throughout: nothing is inferred.",
    "cases": [
      {
        "member": "covers.categories without own_material",
        "reading": "the recipient's duties do not reach the discloser's methods or other own material"
      },
      {
        "member": "purpose.activities without perform_engagements",
        "reading": "an Agent SoW that names this agreement is outside its purpose; a node SHOULD warn"
      },
      {
        "member": "exclusions absent",
        "reading": "no exclusion applies"
      },
      {
        "member": "subcontractors absent",
        "reading": "none"
      },
      {
        "member": "need_to_know empty",
        "reading": "no person beyond the agent named in the seat"
      },
      {
        "member": "survival absent",
        "reading": "duties end when the agreement ends; no default period"
      },
      {
        "member": "at_end absent",
        "reading": "no promise to return or destroy; engagement content still follows its Agent SoW 5.11 retention"
      },
      {
        "member": "compelled absent",
        "reading": "compelled disclosure is still no breach; no promise of notice"
      },
      {
        "member": "disclosure.recipient.processors empty",
        "reading": "material goes to no processor"
      },
      {
        "member": "disclosure.recipient.processors absent",
        "reading": "states nothing"
      }
    ]
  },
